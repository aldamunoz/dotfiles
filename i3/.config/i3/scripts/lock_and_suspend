#!/usr/bin/env bash

# Lock the screen, then suspend after SUSPEND_DELAY seconds if still locked.
# Pressing keys / moving the mouse on the lock screen resets nothing here,
# but unlocking cancels the suspend.

SUSPEND_DELAY=60

betterlockscreen -l

elapsed=0
while [ "$elapsed" -lt "$SUSPEND_DELAY" ]; do
  sleep 5
  elapsed=$((elapsed + 5))
  pgrep -x i3lock > /dev/null || exit 0
done

systemctl suspend
